# Secrets must remain in the backend process environment. Never put them in React.
NVIDIA_API_KEY=
NEMOTRON_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_VISION_MODEL=
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_ENDPOINT=/v1/audio/speech
VOICESTUDIO_PAYLOAD_JSON={"input":"{text}","voice":"{voice}","model":"tts-1","response_format":"wav"}
ORBOT_URL=http://127.0.0.1:16521
HOST_VOICES={"Phil":"Phil","Jim":"Jim"}
DEFAULT_AD_VOICE=Phil
PODCAST_STUDIO_DATA=
